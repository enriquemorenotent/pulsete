{
  "name": "pulsete",
  "version": "0.1.3",
  "description": "A local IRC client with durable workspace state.",
  "homepage": "https://enriquemorenotent.github.io/pulsete/",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/enriquemorenotent/pulsete.git"
  },
  "type": "module",
  "main": "build/desktop/main.cjs",
  "author": {
    "name": "Enrique Moreno",
    "email": "enriquemorenotent@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "pulsete": {
    "shippedDependencies": [
      "@fontsource/ibm-plex-mono",
      "@fontsource/ibm-plex-sans",
      "@radix-ui/react-checkbox",
      "@radix-ui/react-dialog",
      "@radix-ui/react-scroll-area",
      "@radix-ui/react-slot",
      "@radix-ui/react-tabs",
      "better-sqlite3",
      "class-variance-authority",
      "clsx",
      "electron",
      "lucide-react",
      "markdown-to-jsx",
      "radix-ui",
      "react",
      "react-dom",
      "react-virtuoso",
      "tailwind-merge",
      "ws",
      "zod"
    ]
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web:wait\"",
    "dev:server": "PORT=18487 tsx watch server/index.ts",
    "dev:web": "VITE_PULSETE_WS_ORIGIN=ws://127.0.0.1:18487 vite --port 18473",
    "dev:web:wait": "node scripts/wait_for_tcp_port.mjs 127.0.0.1 18487 60000 && npm run dev:web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.desktop.json && tsc -p tsconfig.tests.json",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:desktop": "npm run typecheck && npm run build:web && npm run build:server && npm run build:electron",
    "build:electron": "node scripts/build_node_entries.mjs --desktop",
    "build:server": "node scripts/build_node_entries.mjs --server",
    "build:web": "vite build",
    "build:site": "node scripts/build_landing_site.mjs",
    "audit:shipped": "node scripts/audit_shipped_dependencies.mjs",
    "dist:apt": "npm run build:site && node scripts/build_apt_repository.mjs",
    "dist:linux": "npm run build:desktop && node scripts/build_linux_deb.mjs",
    "lint:test-names": "node scripts/check_test_file_names.mjs",
    "lint:file-length": "python3 scripts/check_source_file_length.py --all --warn-lines 250 --max-lines 500 server shared tests web/src",
    "prestart": "npm run build",
    "start": "PORT=18487 node build/server/index.cjs",
    "test": "npm run lint:test-names && TSX_TSCONFIG_PATH=tsconfig.tests.json node --import tsx --test",
    "test:memory": "TSX_TSCONFIG_PATH=tsconfig.tests.json node --expose-gc --import tsx --test tests/client-memory-regression.test.ts"
  },
  "dependencies": {
    "@openai/codex-security": "^0.1.1",
    "better-sqlite3": "^12.10.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "41.10.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.577.0",
    "markdown-to-jsx": "^9.8.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-virtuoso": "^4.18.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "zod": "^3.25.76"
  }
}
